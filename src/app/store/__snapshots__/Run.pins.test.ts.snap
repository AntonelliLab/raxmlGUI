2.) -T 3 -f d -m GTRGAMMA --HKY85 -p 123 -N 10 -O -o t1,t2 -n pinB.tre -s /in/a.fasta -w /out -q /in/parts.txt -r /in/backbone.tre -g /in/multifurcating.tre
3.) -T 3 -f b -t /out/RAxML_bestTree.pinB.tre -z /out/RAxML_bootstrap.pinR.tre -m GTRGAMMA --HKY85 -O -n pin.tre -s /in/a.fasta -w /out
"
`;

