{
  "name": "raxmlgui",
  "productName": "raxmlGUI",
  "version": "2.0.19",
  "private": true,
  "author": "AntonelliLab <raxmlgui.help@gmail.com>",
  "license": "AGPL-3.0",
  "description": "raxmlGUI - A new graphical front-end for RAxML",
  "homepage": "./",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonelliLab/raxmlGUI.git"
  },
  "bugs": {
    "url": "https://github.com/AntonelliLab/raxmlGUI/issues"
  },
  "keywords": [
    "Electron",
    "RAxML",
    "GUI",
    "Phylogenetics"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "react-test": "jest --watchAll=false",
    "test:e2e": "yarn build && node node_modules/playwright/cli.js test --config e2e/playwright.config.js",
    "test:docs": "node node_modules/playwright/cli.js test --config e2e/docs/playwright.config.js",
    "download-binaries": "node scripts/download-binaries.js",
    "electron-build": "electron-builder",
    "electron-build-win": "electron-builder -w",
    "electron-build-linux": "electron-builder -l",
    "electron-build-all": "electron-builder -mwl",
    "electron-build-publish-all": "electron-builder -mwl -p always",
    "electron-pack": "electron-builder --dir -c.compression=store -c.mac.identity=null",
    "electron-pack-win": "electron-builder -w --dir -c.compression=store",
    "build": "electron-vite build",
    "build-mac": "run-s build electron-build",
    "build-win": "run-s build electron-build-win",
    "build-linux": "run-s build electron-build-linux",
    "build-all": "run-s build electron-build-all",
    "dist-pack": "run-s build electron-pack",
    "dist-pack-win": "run-s build electron-pack-win",
    "publish-all": "run-s build electron-build-publish-all",
    "postinstall-deps": "electron-builder install-app-deps",
    "postinstall-patch": "patch-package",
    "postinstall-electron": "install-electron --no",
    "postinstall": "run-s postinstall-deps postinstall-patch postinstall-electron",
    "docs-serve": "cd docs && bundle exec jekyll serve --config _config.yml,_config_dev.yml",
    "typecheck": "tsc --noEmit",
    "typecheck:baseline": "node scripts/typecheck-baseline.js",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" electron.vite.config.js jest.config.js \"jest/**/*.js\" && node scripts/import-lines.js",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" electron.vite.config.js jest.config.js \"jest/**/*.js\" --fix"
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@sentry/electron": "^4.0.2",
    "allotment": "^1.20.6",
    "classnames": "^2.3.2",
    "clean-stack": "3.0.1",
    "computed-async-mobx": "^4.2.0",
    "d3-array": "^3.2.5",
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0",
    "electron-updater": "^5.2.4",
    "filenamify": "^4.3.0",
    "lodash": "^4.18.1",
    "mobx": "^5.15.7",
    "mobx-react-lite": "^2.2.2",
    "mobx-utils": "^5.6.2",
    "parse-filepath": "^1.0.2",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prismjs": "^1.30.0",
    "prismjs-bibtex": "^2.1.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.0",
    "serialize-error": "^8.1.0",
    "source-map-support": "^0.5.21",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-react-jsx": "7.25.2",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.24.7",
    "@electron/notarize": "^3.1.2",
    "@sentry/bundler-plugins": "11.12.0",
    "@sentry/cli": "^3.8.2",
    "@types/node": "^22.19.1",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "5.2.0",
    "babel-jest": "27.5.1",
    "dotenv": "^17.4.2",
    "download": "^8.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^24.13.3",
    "electron-download": "^4.1.1",
    "electron-vite": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-lodash": "^8.1.0",
    "jest": "27.5.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "build": {
    "appId": "org.jtklein.raxmlGUI2",
    "productName": "raxmlGUI",
    "afterSign": "./scripts/notarize.js",
    "extends": null,
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "files": [
      "!src{,/**/*}",
      "!e2e{,/**/*}",
      "!docs{,/**/*}",
      "!electron.vite.config.js",
      "!static{,/**/*}",
      "!scripts{,/**/*}",
      "!jest{,/**/*}",
      "!test-results{,/**/*}",
      "!playwright-report{,/**/*}"
    ],
    "extraResources": [
      "assets/"
    ],
    "dmg": {
      "icon": "public/disk-image.icns",
      "sign": false
    },
    "mac": {
      "identity": "Johannes Klein (9VR92ZCXA8)",
      "mergeASARs": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "x64ArchFiles": "**/static/bin/*",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "entitlements": "public/entitlements.mac.inherit.plist",
      "entitlementsInherit": "public/entitlements.mac.inherit.plist",
      "extraResources": [
        {
          "from": "static/bin/Mac",
          "to": "static/bin"
        },
        {
          "from": "static/example-files/fasta",
          "to": "static/example-files",
          "filter": [
            "*.txt"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "static/bin/Windows",
          "to": "static/bin"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "extraResources": [
        {
          "from": "static/bin/Linux",
          "to": "static/bin"
        }
      ]
    },
    "publish": {
      "provider": "github"
    }
  },
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1"
  }
}
